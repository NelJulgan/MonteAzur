# ============================================================================
# MONTE AZUR — SERVER ENVIRONMENT TEMPLATE (server/.env.example)
# ============================================================================
# Copy this file to `server/.env` and configure your credentials.

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# Frontend Client Origin (Default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Example: postgresql://postgres:password@localhost:5432/staycation
DATABASE_URL=

# Stripe Secret & Webhook Keys
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
