# ============================================================================
# MONTE AZUR BACKEND — ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL with btree_gist extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staycation

# Cache & Queues (Optional in Concept Mode — System defaults to in-memory cache and event-loop dispatching)
# REDIS_URL=redis://localhost:6379

# Authoritative Property UUID (Monte Azur Luxury Villa)
PROPERTY_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Stripe Payment Processing (Get keys from Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_placeholder_for_local_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_local_development

# Resend Email Notifications (Get API key from resend.com)
RESEND_API_KEY=re_placeholder_for_local_development
EMAIL_FROM=reservations@monteazur.com

# Google Calendar Synchronization (Google Cloud Service Account JWT)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="YOUR_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_HERE"
GOOGLE_CALENDAR_ID=primary

# Client URLs for CORS and Stripe Redirects
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://monteazur.com,https://www.monteazur.com

# Phase 3: Administration & Security
ADMIN_API_KEY=your_admin_secret_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Phase 3: External OTA Channel Synchronization (Airbnb, Agoda, Booking.com)
EXTERNAL_ICAL_URLS=https://www.airbnb.com/calendar/ical/SAMPLE_AIRBNB_FEED.ics

# Phase 4: Telegram Management Bot Alerts & Webhooks
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=-1001234567890_placeholder
ADMIN_TELEGRAM_ID=-1001234567890_placeholder
ALLOWED_CHAT_IDS=-1001234567890_placeholder
TELEGRAM_WEBHOOK_SECRET=ma_telegram_secret_token_placeholder
