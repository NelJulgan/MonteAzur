{
  "name": "monte-azur-staycation",
  "version": "1.0.0",
  "type": "module",
  "description": "Architectural coastal retreat and luxury villa staycation website",
  "scripts": {
    "dev": "vite --host --port 5173",
    "backend": "npm --prefix backend run dev",
    "server": "npm --prefix backend run dev",
    "db:seed": "npm --prefix backend run db:seed",
    "server:legacy": "node server/src/server.js",
    "compile:css": "node scripts/compile-bem.cjs",
    "prebuild": "npm run compile:css",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "pg": "^8.23.1",
    "stripe": "^23.0.1"
  }
}
